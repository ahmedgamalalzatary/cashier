{
  "name": "@cashier/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch --conditions=development src/index.ts",
    "dev:worker": "tsx watch --conditions=development src/worker.ts",
    "build": "pnpm --filter @cashier/shared build && pnpm --filter @cashier/db build && pnpm --filter @cashier/server-core build && tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "start:worker": "node dist/worker.js",
    "test": "pnpm --filter @cashier/server-core... build && pnpm run test:unit && pnpm run test:mysql",
    "test:watch": "vitest",
    "lint": "eslint src tests",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:seed": "tsx src/db/seed.ts",
    "test:unit": "vitest run",
    "test:mysql": "turbo run test:mysql:api --filter=@cashier/db"
  },
  "dependencies": {
    "@cashier/db": "workspace:*",
    "@cashier/server-core": "workspace:*",
    "@cashier/shared": "workspace:*",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "drizzle-orm": "^0.43.1",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.14.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.18",
    "@types/express": "^5.0.1",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.15.0",
    "@types/supertest": "^6.0.3",
    "drizzle-kit": "^0.31.1",
    "eslint": "^9.27.0",
    "supertest": "^7.1.1",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.32.0",
    "vitest": "^3.1.4"
  }
}
