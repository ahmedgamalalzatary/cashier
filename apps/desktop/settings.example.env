# Stored in the Cashier user-data folder, outside the installation directory.
# MySQL must already be installed and the database migrations applied.
DATABASE_URL="mysql://cashier:replace-with-local-password@localhost:3306/cashier"
# Required until the Phase 9 link screen writes this automatically.
BRANCH_ID="replace-with-this-branch-uuid"
JWT_SECRET="change-me"
ADMIN_NAME="المدير"
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="replace-with-admin-password"
# Set true and configure external credentials to enable background syncing.
DESKTOP_SYNC_ENABLED=false
EXTERNAL_CATALOG_ENABLED=false
