# Stored in C:\ProgramData\Cashier\settings.env, shared by every Windows user.
# Cashier creates its own database and adds MYSQL_PASSWORD, MYSQL_ROOT_PASSWORD
# and JWT_SECRET on its first start. Never change or delete those three lines.
# BRANCH_ID and DEVICE_TOKEN are written by the "Link this PC" screen on the
# first start; leave them out. ONLINE_API_URL is only for testing against
# another online site (default https://cashier.biscofa.tech/api).
# Admin accounts and password hashes come from the online site on start and
# every 15 minutes. ADMIN_* credentials are not used on the PC.
# Linking writes DESKTOP_SYNC_ENABLED=false when this key is absent. Set true and
# configure external credentials to enable background syncing.
DESKTOP_SYNC_ENABLED=false
EXTERNAL_CATALOG_ENABLED=false
