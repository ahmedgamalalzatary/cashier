{
  "name": "cashier",
  "private": true,
  "version": "0.1.0",
  "description": "Cashier + warehouse system (POS, main warehouse, cafe sub-warehouse) — see docs/system-specs.md",
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "dev": "turbo run dev dev:worker",
    "dev:web": "pnpm --filter @cashier/web dev",
    "dev:api": "pnpm --filter @cashier/api dev",
    "dev:desktop": "turbo run dev:desktop --filter=@cashier/desktop --concurrency=1",
    "build:desktop": "turbo run build:desktop --filter=@cashier/desktop --concurrency=1",
    "lint:desktop": "turbo run format:check lint --filter=@cashier/desktop --concurrency=1",
    "typecheck:desktop": "turbo run typecheck --filter=@cashier/desktop --concurrency=1",
    "test:desktop": "turbo run test --filter=@cashier/desktop --concurrency=1",
    "smoke:desktop": "turbo run smoke:desktop --filter=@cashier/desktop --concurrency=1",
    "configure:desktop": "pnpm --filter @cashier/desktop configure:desktop",
    "version:desktop": "pnpm --filter @cashier/desktop version:desktop",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md,css}\""
  },
  "devDependencies": {
    "prettier": "^3.5.3",
    "turbo": "^2.5.3"
  },
  "engines": {
    "node": ">=20.11"
  }
}
