# Copy to .env (dev). Tests use .env.test automatically.
DATABASE_URL="mysql://root:password@localhost:3306/cashier"
# Needed by configure:desktop; use the UUID of the one branch in the local DB.
# The ordinary development API remains unpinned. Desktop reads its settings.env.
# BRANCH_ID="replace-with-this-branch-uuid"
JWT_SECRET="change-me"
# No PORT here: the shop API defaults to 4000 and the online API to 4001, so
# setting one value for both would make them fight over a single port.
NEXT_PUBLIC_API_URL=http://localhost:4000
# Web development and packaged Tauri origins across platforms.
CORS_ORIGIN=http://localhost:3000,http://tauri.localhost,https://tauri.localhost,tauri://localhost
# Set true only when the API runs behind one trusted reverse proxy.
TRUST_PROXY=false
# Service origin only; endpoint paths are added by the API.
EXTERNAL_ORDERS_BASE_URL=https://orders.example.com
EXTERNAL_ORDERS_PHONE_NUMBER="01000000000"
EXTERNAL_ORDERS_PASSWORD="external-admin-password"
# Set false to keep a local menu and refresh only online orders.
EXTERNAL_CATALOG_ENABLED=true
ADMIN_NAME="المدير"
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-this-password"
