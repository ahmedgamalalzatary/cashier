# syntax=docker/dockerfile:1.7

FROM node:22-bookworm-slim AS pnpm
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
RUN corepack enable && corepack prepare pnpm@11.13.0 --activate
WORKDIR /app

FROM pnpm AS dependencies
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/online-api/package.json apps/online-api/package.json
COPY packages/db/package.json packages/db/package.json
COPY packages/server-core/package.json packages/server-core/package.json
COPY packages/shared/package.json packages/shared/package.json
RUN pnpm install --frozen-lockfile --filter @cashier/online-api...

FROM dependencies AS build
COPY tsconfig.base.json ./
COPY apps/online-api ./apps/online-api
COPY packages/db ./packages/db
COPY packages/server-core ./packages/server-core
COPY packages/shared ./packages/shared
RUN pnpm --filter @cashier/online-api build

FROM dependencies AS migrate
COPY tsconfig.base.json ./
COPY packages/db/package.json packages/db/package.json
COPY packages/db/drizzle.config.ts packages/db/drizzle.config.ts
COPY packages/db/drizzle ./packages/db/drizzle
COPY packages/db/scripts ./packages/db/scripts
COPY packages/db/src ./packages/db/src
COPY packages/shared ./packages/shared
WORKDIR /app/packages/db
CMD ["pnpm", "db:migrate"]

FROM pnpm AS production-dependencies
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/online-api/package.json apps/online-api/package.json
COPY packages/db/package.json packages/db/package.json
COPY packages/server-core/package.json packages/server-core/package.json
COPY packages/shared/package.json packages/shared/package.json
RUN pnpm install --frozen-lockfile --prod --filter @cashier/online-api...

FROM node:22-bookworm-slim AS runtime
ENV NODE_ENV=production
WORKDIR /app
COPY --from=production-dependencies /app/node_modules ./node_modules
COPY --from=production-dependencies /app/apps/online-api/node_modules ./apps/online-api/node_modules
COPY --from=production-dependencies /app/packages/db/node_modules ./packages/db/node_modules
COPY --from=production-dependencies /app/packages/server-core/node_modules ./packages/server-core/node_modules
COPY --from=production-dependencies /app/packages/shared/node_modules ./packages/shared/node_modules
COPY --from=build /app/packages/db ./packages/db
COPY --from=build /app/packages/server-core ./packages/server-core
COPY --from=build /app/packages/shared ./packages/shared
COPY --from=build /app/apps/online-api/dist ./apps/online-api/dist
COPY apps/online-api/package.json ./apps/online-api/package.json
WORKDIR /app/apps/online-api
USER node
EXPOSE 4000
CMD ["node", "dist/index.js"]