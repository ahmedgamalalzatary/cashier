# syntax=docker/dockerfile:1.7

FROM node:22-bookworm-slim AS pnpm
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
RUN corepack enable && corepack prepare pnpm@11.13.0 --activate
WORKDIR /app

FROM pnpm AS dependencies
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/online-web/package.json apps/online-web/package.json
COPY packages/shared/package.json packages/shared/package.json
COPY packages/web-core/package.json packages/web-core/package.json
RUN pnpm install --frozen-lockfile --filter @cashier/online-web...

FROM dependencies AS build
ENV NEXT_TELEMETRY_DISABLED=1
COPY tsconfig.base.json ./
COPY apps/online-web ./apps/online-web
COPY packages/shared ./packages/shared
COPY packages/web-core ./packages/web-core
RUN pnpm --filter @cashier/shared build && pnpm --filter @cashier/online-web build

FROM node:22-bookworm-slim AS runtime
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV HOSTNAME=0.0.0.0
ENV PORT=3000
WORKDIR /app
# The site calls "/api" on its own origin, so no API URL is baked in or passed
# at runtime: the host Nginx forwards /api to online-api.
COPY --from=build --chown=node:node /app/apps/online-web/.next/standalone ./
COPY --from=build --chown=node:node /app/apps/online-web/.next/static ./apps/online-web/.next/static
USER node
EXPOSE 3000
CMD ["node", "apps/online-web/server.js"]